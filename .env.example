# Local development defaults
DATABASE_URL=postgres://ledgerly:ledgerly@127.0.0.1:5432/ledgerly
LEDGER_LISTEN=0.0.0.0:8080
JWT_SECRET=dev-only-change-me-ledgerly-secret
JWT_ED25519_SEED=dev-ed25519-seed
OBJECT_STORE_DIR=/tmp/ledgerly-objects
OBJECT_STORE_HMAC_SECRET=dev-object-hmac-secret
OBJECT_STORE_PUBLIC_BASE=http://127.0.0.1:8080
RATE_LIMIT_RPS=100
AUTH_RATE_LIMIT_RPS=20
