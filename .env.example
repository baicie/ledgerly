# Local development defaults
DATABASE_URL=postgres://ledgerly:ledgerly@127.0.0.1:5432/ledgerly
LEDGER_LISTEN=0.0.0.0:8080
JWT_SECRET=dev-only-change-me-ledgerly-secret
JWT_ED25519_SEED=dev-ed25519-seed
# JWT_ED25519_PREVIOUS_SEED=
OBJECT_STORE_DIR=/tmp/ledgerly-objects
OBJECT_STORE_HMAC_SECRET=dev-object-hmac-secret
# OBJECT_STORE_HMAC_PREVIOUS_SECRET=
OBJECT_STORE_PUBLIC_BASE=http://127.0.0.1:8080
# OBJECT_STORE_BACKEND=s3
# S3_ENDPOINT=http://127.0.0.1:9090
# S3_REGION=us-east-1
# S3_BUCKET=ledgerly
# S3_ACCESS_KEY_ID=foo
# S3_SECRET_ACCESS_KEY=bar
# S3_PREFIX=ledgerly
# S3_FORCE_PATH_STYLE=true
# S3_ALLOW_HTTP=true
RATE_LIMIT_RPS=100
AUTH_RATE_LIMIT_RPS=20
# AUDIT_RETENTION_DAYS=365
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# LEDGER_ENV=production
