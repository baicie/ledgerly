# Example for docker-compose.prod.yml + docker-compose.vm.yml.
# The real file lives only on the VM as /opt/ledgerly/.env.prod.

LEDGER_BIND_ADDRESS=127.0.0.1
LEDGER_PORT=8081

POSTGRES_DB=ledgerly
POSTGRES_USER=ledgerly
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgres://ledgerly:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/ledgerly

JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ED25519_SEED=CHANGE_ME_ED25519_SEED
OBJECT_STORE_HMAC_SECRET=CHANGE_ME_HMAC
OBJECT_STORE_PUBLIC_BASE=https://api.ledgerly.example.com
LEDGER_BACKUP_PASSWORD=CHANGE_ME_BACKUP_PASSWORD
BACKUP_KEEP=4
BACKUP_INTERVAL_HOURS=24
# Alert thresholds for local and offsite bundle storage.
BACKUP_CAPACITY_WARN_BYTES=21474836480
BACKUP_CAPACITY_CRITICAL_BYTES=53687091200
# Named volume by default. Set an absolute host path to use a mounted offsite disk.
BACKUP_OFFSITE_HOST_MOUNT=ledgerly_backups_offsite
RECOVERY_DRILL_ENABLED=true
RECOVERY_DRILL_INTERVAL_HOURS=720
# Optional admin connection with CREATEDB. Empty falls back to DATABASE_URL.
RECOVERY_DRILL_DATABASE_URL=
CORS_ALLOWED_ORIGINS=https://app.ledgerly.example.com
AUTH_COOKIE_SECURE=true
LEDGER_ENV=production
RUST_LOG=info
