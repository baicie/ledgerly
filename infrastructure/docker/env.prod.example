# Example production env for docker-compose.prod.yml
# Copy to server as /opt/ledgerly/.env.prod (never commit real secrets).

LEDGER_IMAGE=ghcr.io/baicie/ledgerly-server:latest
LEDGER_PORT=8080

# Reuse host PostgreSQL (create DB/user once; do not start a new PG container)
# If PG listens on the host:
DATABASE_URL=postgres://ledgerly:CHANGE_ME@host.docker.internal:5432/ledgerly

JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ED25519_SEED=CHANGE_ME_ED25519_SEED
OBJECT_STORE_HMAC_SECRET=CHANGE_ME_HMAC
OBJECT_STORE_PUBLIC_BASE=https://ledgerly.example.com
# local is the default; set s3 and fill the S3_* values for object storage.
OBJECT_STORE_BACKEND=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_PREFIX=ledgerly
S3_FORCE_PATH_STYLE=true
S3_ALLOW_HTTP=false
LEDGER_BACKUP_PASSWORD=CHANGE_ME_BACKUP_PASSWORD
BACKUP_KEEP=4
BACKUP_INTERVAL_HOURS=24
# Alert thresholds for local and offsite bundle storage.
BACKUP_CAPACITY_WARN_BYTES=21474836480
BACKUP_CAPACITY_CRITICAL_BYTES=53687091200
# Named volume by default. Set an absolute host path to use a mounted offsite disk.
BACKUP_OFFSITE_HOST_MOUNT=ledgerly_backups_offsite
RECOVERY_DRILL_ENABLED=true
RECOVERY_DRILL_INTERVAL_HOURS=720
# Optional admin connection with CREATEDB. Empty falls back to DATABASE_URL.
RECOVERY_DRILL_DATABASE_URL=
CORS_ALLOWED_ORIGINS=https://app.ledgerly.example.com
AUTH_COOKIE_SECURE=true
# Optional Prometheus/Alertmanager/Grafana stack.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8082
ALERTMANAGER_PORT=9093
ALERTMANAGER_WEBHOOK_URL=https://alerts.example.com/ledgerly
ALERTMANAGER_SEND_RESOLVED=true
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD
GRAFANA_ROOT_URL=http://localhost:3000
LEDGER_ENV=production
RUST_LOG=info
