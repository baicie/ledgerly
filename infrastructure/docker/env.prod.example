# Example production env for docker-compose.prod.yml
# Copy to server as /opt/ledgerly/.env.prod (never commit real secrets).

LEDGER_IMAGE=ghcr.io/baicie/ledgerly-server:latest
LEDGER_PORT=8080

# Reuse host PostgreSQL (create DB/user once; do not start a new PG container)
# If PG listens on the host:
DATABASE_URL=postgres://ledgerly:CHANGE_ME@host.docker.internal:5432/ledgerly

JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ED25519_SEED=CHANGE_ME_ED25519_SEED
OBJECT_STORE_HMAC_SECRET=CHANGE_ME_HMAC
OBJECT_STORE_PUBLIC_BASE=https://ledgerly.example.com
CORS_ALLOWED_ORIGINS=https://app.ledgerly.example.com
AUTH_COOKIE_SECURE=true
LEDGER_ENV=production
RUST_LOG=info
